## ---------------------------------------------------------------------------
## Logs and reports
## ---------------------------------------------------------------------------
*.log
logs/
reports/*
!reports/.gitkeep
!reports/README.md

# Exception: the IO-VNBD forensic report and its diagnostic plots (~470 KB)
# ARE tracked. They are nominally "generated", but regenerating them requires
# downloading the full 1.8 GB dataset, so for anyone cloning this repo they
# are effectively source documents — and the root README links to the report.
!reports/io_vnbd/
!reports/io_vnbd/IO_VNBD_Forensic_Report.md
!reports/io_vnbd/plots/
!reports/io_vnbd/plots/*.png
!reports/io_vnbd/phase2_plots/
!reports/io_vnbd/phase2_plots/*.png

# Same exception, same reason, for the Phase 3 sensor-frame validation report
# and its figures: the root README links to the report, and regenerating it
# needs the full raw dataset plus a Phase 2 run.
!reports/sensor_alignment/
!reports/sensor_alignment/Phase3_Sensor_Frame_Validation.md
!reports/sensor_alignment/plots/
!reports/sensor_alignment/plots/*.png

## ---------------------------------------------------------------------------
## Data (see data/README.md — datasets are NEVER committed to Git)
## ---------------------------------------------------------------------------
# Raw source datasets (e.g. IO-VNBD) must never be tracked.
data/raw/*
!data/raw/.gitkeep
data/IO-VNBD_dataset/

# Derived data is regenerable from raw data + code; ignored by default.
data/intermediate/*
!data/intermediate/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/sequences/*
!data/sequences/.gitkeep

# data/metadata/ IS tracked by default (small, hand-written dataset docs).

## ---------------------------------------------------------------------------
## Models
## ---------------------------------------------------------------------------
models/checkpoints/*
!models/checkpoints/.gitkeep
models/exported/*
!models/exported/.gitkeep
*.onnx
*.pt
*.pth
*.ckpt

# models/metadata/ IS tracked by default (small, hand-written model docs).

## ---------------------------------------------------------------------------
## Secrets / local overrides
## ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local.yaml
