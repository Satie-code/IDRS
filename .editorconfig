root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 100

[*.{c,h,cc,hh,cpp,hpp,cxx,hxx}]
indent_size = 4

[CMakeLists.txt]
indent_size = 2

[*.{cmake}]
indent_size = 2

[*.{yaml,yml}]
indent_size = 2

[*.{json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab
